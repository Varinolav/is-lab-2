            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
    vars.put(&apos;importCode&apos;, prev.responseCode)
    assert prev.responseCode in [&apos;201&apos;,&apos;409&apos;] : &apos;Неожиданный HTTP &apos; + prev.responseCode
    if (prev.responseCode == &apos;201&apos;) {
        def data = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
        assert data.importedCount == 1
