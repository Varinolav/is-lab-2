          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">${bulkBody}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Content-Type">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">multipart/form-data; boundary=JMeterBoundary</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Дождаться обоих пользователей">
            <intProp name="groupSize">2</intProp>
            <longProp name="timeoutInMs">360000</longProp>
          </SyncTimer>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Проверка результата">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
    props.put(&apos;jm.bulk.&apos; + vars.get(&apos;run&apos;) + &apos;.&apos; + ctx.threadNum, prev.responseCode)
    assert prev.responseCode in [&apos;201&apos;,&apos;409&apos;] : &apos;Неожиданный HTTP &apos; + prev.responseCode
    if (prev.responseCode == &apos;201&apos;) {
        def data = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
        assert data.importedCount == 2000 : &apos;Должно импортироваться 2000 фильмов&apos;
    }
    prev.setSuccessful(true)
} catch (AssertionError | Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(e.message + &apos;\nResponse: &apos; + prev.responseDataAsString.take(2000))
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Прочитать свой файл и добавить номер запуска">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def letter = ctx.threadNum == 0 ? &apos;a&apos; : &apos;b&apos;
def baseDir = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir())
def file = new File(baseDir, &apos;../import/concurrency-&apos; + letter + &apos;-2000.json&apos;).canonicalFile
assert file.isFile() : &apos;Не найден файл: &apos; + file
 def movies = new groovy.json.JsonSlurper().parse(file, &apos;UTF-8&apos;)
assert movies.size() == 2000
movies.each { it.name = &apos;Bulk-&apos; + vars.get(&apos;run&apos;) + &apos;-&apos; + it.name }
vars.put(&apos;bulkNames&apos;, groovy.json.JsonOutput.toJson(movies.collect { it.name }))
def json = groovy.json.JsonOutput.toJson(movies)
vars.put(&apos;bulkBody&apos;, &apos;--JMeterBoundary\r\nContent-Disposition: form-data; name=&quot;file&quot;; filename=&quot;concurrency-&apos; + letter + &apos;-2000.json&quot;\r\nContent-Type: application/json\r\n\r\n&apos; + json + &apos;\r\n--JMeterBoundary--\r\n&apos;)
</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="15 Проверить 2000 фильмов и полный откат второго файла">
          <intProp name="HTTPSampler.connect_timeout">5000</intProp>
          <intProp name="HTTPSampler.response_timeout">300000</intProp>
          <stringProp name="HTTPSampler.domain">${host}</stringProp>
          <stringProp name="HTTPSampler.port">${port}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">${base}/movies</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Content-Type">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Дождаться обоих пользователей">
            <intProp name="groupSize">2</intProp>
            <longProp name="timeoutInMs">360000</longProp>
          </SyncTimer>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Проверка результата">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
    assert prev.responseCode == &apos;200&apos; : &apos;Неожиданный HTTP &apos; + prev.responseCode
    def run = vars.get(&apos;run&apos;)
    def codes = (0..1).collect { props.getProperty(&apos;jm.bulk.&apos; + run + &apos;.&apos; + it) }.sort()
    assert codes == [&apos;201&apos;,&apos;409&apos;] : &apos;Ожидались один успех 201 и один конфликт 409: &apos; + codes
    def movies = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    def imported = movies.findAll { it.name.startsWith(&apos;Bulk-&apos; + run + &apos;-&apos;) }
    assert imported.size() == 2000 : &apos;Ожидалось ровно 2000 фильмов, найдено: &apos; + imported.size()
    def names = imported.collect { it.name }.toSet()
    assert names.size() == 2000 : &apos;Найдены повторяющиеся названия&apos;
    def ownNames = new groovy.json.JsonSlurper().parseText(vars.get(&apos;bulkNames&apos;)).toSet()
    def ownCode = props.getProperty(&apos;jm.bulk.&apos; + run + &apos;.&apos; + ctx.threadNum)
    if (ownCode == &apos;201&apos;) {
        assert names == ownNames : &apos;Успешный файл сохранен не полностью&apos;
    } else {
        def present = ownNames.intersect(names)
        assert present.size() == 1 : &apos;После отката остались фильмы второго файла: &apos; + present.size()
        assert present.first().endsWith(&apos;_SHARED_MOVIE&apos;) : &apos;Сохранился фильм из отмененного импорта&apos;
    }
    prev.setSuccessful(true)
} catch (AssertionError | Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(e.message)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="Результаты запросов">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
