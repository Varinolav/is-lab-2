Content-Type: application/json&#xd;
&#xd;
[{&quot;name&quot;:&quot;Import-${user}&quot;,&quot;coordinates&quot;:{&quot;x&quot;:10,&quot;y&quot;:20},&quot;director&quot;:{&quot;name&quot;:&quot;Director&quot;,&quot;location&quot;:{&quot;x&quot;:1,&quot;y&quot;:2,&quot;z&quot;:3}},&quot;operator&quot;:{&quot;name&quot;:&quot;Operator&quot;,&quot;location&quot;:{&quot;x&quot;:4,&quot;y&quot;:5,&quot;z&quot;:6}},&quot;mpaaRating&quot;:&quot;G&quot;,&quot;oscarsCount&quot;:0}]&#xd;
--JMeterBoundary--&#xd;
