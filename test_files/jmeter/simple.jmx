        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="07 Проверить уникальность и получить общий фильм" enabled="true">
          <intProp name="HTTPSampler.connect_timeout">5000</intProp>
          <intProp name="HTTPSampler.response_timeout">30000</intProp>
          <stringProp name="HTTPSampler.domain">${host}</stringProp>
          <stringProp name="HTTPSampler.port">${port}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">${base}/movies</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Content-Type" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Дождаться обоих пользователей" enabled="true">
            <intProp name="groupSize">2</intProp>
            <longProp name="timeoutInMs">15000</longProp>
          </SyncTimer>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Проверка результата" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
    def allowed = &apos;200&apos;.split(&apos;,&apos;).toList()
    assert prev.responseCode in allowed : &apos;HTTP &apos; + prev.responseCode + &apos;: &apos; + prev.responseDataAsString
    prev.setSuccessful(true)
    def data = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    def run = vars.get(&apos;run&apos;)
    def found = data.findAll { it.name == &apos;JMeter-&apos; + run }
    assert found.size() == 1 : &apos;Должен существовать ровно один фильм&apos;
    vars.put(&apos;id&apos;, found[0].id.toString())
    vars.put(&apos;movie&apos;, groovy.json.JsonOutput.toJson(found[0]))
    assert (0..1).collect { props.getProperty(&apos;jm.create.&apos; + run + &apos;.&apos; + it) }.sort() == [&apos;201&apos;,&apos;409&apos;] : &apos;Должны быть один успех 201 и один конфликт 409&apos;
} catch (AssertionError | Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;HTTP &apos; + prev.responseCode + &apos;: &apos; + e.message + &apos;\nResponse: &apos; + prev.responseDataAsString.take(2000))
