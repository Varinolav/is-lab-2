            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
    def allowed = &apos;201&apos;.split(&apos;,&apos;).toList()
    assert prev.responseCode in allowed : &apos;HTTP &apos; + prev.responseCode + &apos;: &apos; + prev.responseDataAsString
    prev.setSuccessful(true)
} catch (AssertionError | Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;HTTP &apos; + prev.responseCode + &apos;: &apos; + e.message + &apos;\nResponse: &apos; + prev.responseDataAsString.take(2000))
}</stringProp>
          </JSR223Assertion>
